# Copy values to env/win-release.env or provide them in PowerShell/CMD.
# Do not commit env/win-release.env or real signing credentials.

# Public HTTPS origin for the static release feed.
# GitHub Pages example: https://<owner>.github.io/<repo>
RELEASE_PUBLIC_ORIGIN=

# Release identity.
RELEASE_CHANNEL=stable
# Leave RELEASE_VERSION empty to auto-bump patch only from package.json.
# Use RELEASE_VERSION=0.13.0 for a manual major/minor release.
RELEASE_VERSION=
AUTO_BUMP_PATCH=true
AUTO_BUILD_RELEASE_TOOLS=true

# Windows release target. Only win_x64 is supported today.
RELEASE_TARGET=win_x64
RELEASE_NAMESPACE=release-stable-win

# Build target can be: nsis, all, dir, zip.
# nsis is the recommended updater release target. The launcher payload is built
# and exported as a shared version asset alongside the NSIS installer.
BUILD_TARGET=nsis

# SIGN_MODE can be: off, on.
SIGN_MODE=off

# Required only when SIGN_MODE=on. The certificate must be installed in the
# Windows certificate store and reachable by signtool.
OD_WIN_SIGN_CERT_SHA1=
# OD_WIN_SIGNTOOL_PATH=C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\signtool.exe
# OD_WIN_SIGN_TIMESTAMP_URL=http://timestamp.digicert.com

# Smoke can be: skip, core, full.
SMOKE_MODE=skip

# Optional workspace/output overrides.
# WORK_ROOT=C:\.tmp\nn-design-release\win_x64
# TOOLS_PACK_DIR=C:\.tmp\nn-design-release\win_x64\tools-pack
# TOOLS_PACK_CACHE_DIR=C:\.tmp\nn-design-release\win_x64\tools-pack-cache
# RELEASE_PUBLIC_DIR=.tmp\release-public

# GitHub deployment stores installer/payload artifacts in versioned Releases
# such as v0.12.2, while Pages serves only metadata.
DEPLOY_PUBLIC_GITHUB=true
DEPLOY_RELEASE_ASSETS_TO_GITHUB_RELEASES=true
# RELEASE_PUBLIC_GH_REPO=<owner>/nn-design-release-feed
