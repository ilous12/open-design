# Copy values to env/mac-release.env or provide them in your shell.
# Do not commit env/mac-release.env, .p12 files, or real passwords.

# Public HTTPS origin for the static release feed.
# GitHub Pages example: https://<owner>.github.io/<repo>
RELEASE_PUBLIC_ORIGIN=

# Release identity.
RELEASE_CHANNEL=stable
RELEASE_VERSION=0.12.1

# mac_arm64 on Apple Silicon, mac_x64 on Intel.
# Leave empty to auto-detect the current Mac architecture.
# RELEASE_TARGET=mac_arm64

# SIGN_MODE can be: no, sign-only, notarize.
SIGN_MODE=notarize

# Developer ID Application certificate.
CSC_LINK=
CSC_KEY_PASSWORD=

# Notarization. Prefer APPLE_NOTARY_KEYCHAIN_PROFILE when configured.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
# APPLE_NOTARY_KEYCHAIN_PROFILE=

# Optional: export files directly into a separate public Git repo checkout.
# RELEASE_PUBLIC_DIR=/path/to/public-release-repo

# GitHub deployment stores all DMG/ZIP/payload artifacts in versioned Releases
# such as v0.12.1, while Pages serves only metadata.
DEPLOY_RELEASE_ASSETS_TO_GITHUB_RELEASES=true
