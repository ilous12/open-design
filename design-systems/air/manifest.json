{
  "schemaVersion": "od-design-system-project/v1",
  "id": "air",
  "name": "AIR",
  "category": "Telecom & Lifestyle",
  "description": "AIR design system derived from sktair.com: white canvas, AIR Blue actions, pale-blue soft capsule surfaces, Pretend typography, and readable mobile-first service flows.",
  "source": {
    "type": "bundled",
    "origin": "https://www.sktair.com"
  },
  "files": {
    "design": "DESIGN.md",
    "tokens": "tokens.css",
    "designTokens": "design-tokens.json",
    "tailwind": "tailwind-v4.css",
    "components": "components.html"
  },
  "assetsDir": "assets",
  "usage": "USAGE.md",
  "componentsManifest": "components.manifest.json",
  "importMode": "normalized",
  "craft": {
    "applies": [
      "color",
      "typography",
      "accessibility-baseline"
    ],
    "suggested": [
      "form-validation",
      "state-coverage"
    ],
    "exemptions": []
  },
  "preview": {
    "dir": "preview",
    "pages": [
      {
        "path": "preview/colors.html",
        "role": "colors",
        "title": "Colors"
      },
      {
        "path": "preview/typography.html",
        "role": "typography",
        "title": "Typography"
      },
      {
        "path": "preview/spacing.html",
        "role": "spacing",
        "title": "Spacing"
      },
      {
        "path": "preview/brand-assets.html",
        "role": "brand-assets",
        "title": "Brand Assets"
      }
    ]
  },
  "sourceFiles": {
    "evidence": "source/evidence.md",
    "tokens": "source/tokens.source.json",
    "report": "source/token-contract.report.json"
  }
}
